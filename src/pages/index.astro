---
/**
 * L'ACCUEIL — neuf sections, dans l'ordre des questions d'un Cugnalais.
 *
 * Un Cugnalais qui tape « club de boxe Cugnaux » lit « Portet-sur-Garonne, la
 * commune voisine ». Sa question n'est pas « j'y vais comment » — c'est
 * « c'est vraiment à côté ? ». Et la réponse est un fait cadastral : les deux
 * communes se touchent. Il se dessine, et il vient en deuxième, avant tout.
 *
 *   01 Le héros — c'est pour moi ? et c'est quel club ?
 *   02 La limite — Portet, c'est vraiment à côté ?
 *   03 La première fois — je n'ai jamais fait ça, ça se passe comment ?
 *   04 Les cours — il y a plein de noms, je choisis quoi ?
 *   05 Le moteur — et je viens quand ?
 *   06 Le trajet — j'y vais comment, en bus ?
 *   07 Les questions — ce qui me reste à vérifier
 *   08 Le secteur — je viens d'une commune à côté ?
 *   09 Décider — je fais quoi, là, maintenant ?
 *
 * Castelginest ouvre sur le club puis le trajet ; Muret fusionne bus et club.
 * Ici, la limite vient d'abord, la première séance ensuite — parce qu'une fois
 * rassuré sur le lieu, à 34 ans, la peur suivante est celle du débutant.
 *
 * Aucun chiffre écrit à la main : tout vient des registres. Chaque section se
 * referme sur une porte du club dont le libellé n'a pas encore servi.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LaLimite from '../components/LaLimite.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, VILLE, LIMITROPHES, NOTE_SECTEUR, CONTACT } from '../data/verite';
import { COMMUNES } from '../data/communes';
import { OFFRES, offresDe } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { MEILLEUR, ARRIVEE, enLettres } from '../data/transports';

/** « a, b, c et d » depuis une liste, sans jamais l'écrire à la main. */
const enumerer = (noms: readonly string[]) =>
  noms.length > 1 ? `${noms.slice(0, -1).join(', ')} et ${noms[noms.length - 1]}` : noms[0] ?? '';

/**
 * Les trois voies, puis les deux portes à part. Derrière chacune, les
 * intitulés exacts que le club publie — jamais une description écrite.
 */
const VOIES = [
  { nom: 'Frapper', page: 'boxe-anglaise', offres: [...offresDe('boxe-anglaise'), ...offresDe('kick-boxing')], quoi: 'les poings, ou les poings et les jambes, sur le ring' },
  { nom: 'Contrôler au sol', page: 'mma', offres: offresDe('grappling'), quoi: 'du contrôle et des soumissions, sur les tatamis' },
  { nom: 'Les deux', page: 'mma', offres: offresDe('mma'), quoi: 'debout, au corps à corps et au sol, dans la cage' },
  { nom: 'Pour ton enfant', page: 'boxe-enfants', offres: offresDe('enfants'), quoi: 'en touché contrôlé, par tranche d’âge' },
  { nom: 'Le geste sans l’opposition', page: 'boxing-fitness', offres: [...offresDe('femme'), ...offresDe('physique')], quoi: 'le cardio et la préparation, aux sacs' },
] as const;

const BUS = MEILLEUR.etapes[0];
const L5 = MEILLEUR.etapes[1];
const COTE = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const COMBIEN_COURS = enLettres(OFFRES.length);
const COMBIEN_LIMITROPHES = enLettres(LIMITROPHES.length);
/** « de A, de B ou de C » : la phrase du titre, écrite depuis le registre. */
const DEPUIS_COMMUNES = (() => {
  const d = COMMUNES.map((c) => `de ${c.nom}`);
  return d.length > 1 ? `${d.slice(0, -1).join(', ')} ou ${d[d.length - 1]}` : d[0] ?? '';
})();
const VOITURE = DESTINATION.acces.replace(/^Par /, 'par ').replace(/\.$/, '');

/**
 * Les questions telles qu'on les pose. Chaque réponse s'ouvre sur ce qui est
 * vrai, et c'est ici que vit la preuve : l'adresse, la cage, la voiture, l'enfant.
 */
const QUESTIONS = [
  {
    titre: `Où est le club, exactement ?`,
    texte: `Au ${DESTINATION.adresse}. ${COTE('Surface')}, ${COTE('Équipement')}, accueil ${DESTINATION.horaires.valeur}. ${NOTE_SECTEUR}`,
  },
  {
    titre: 'Il y a une vraie cage pour le MMA ?',
    texte: `Oui, et l’entraînement se fait dedans. ${DESTINATION.singularite} Le grappling et le jiu-jitsu brésilien sont des cours à part, en travail au sol.`,
  },
  {
    titre: 'Et la boxe thaï ?',
    texte: 'Le club publie le kick-boxing — la boxe pieds-poings — pour les adultes comme pour les enfants et les ados. La boxe thaï ajoute les coudes et les genoux : si c’est bien elle que tu cherches, dis-le dans ton message et on te dit où elle se pratique dans le réseau.',
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte: `Oui, sur ${enLettres(offresDe('enfants').length)} niveaux : ${enumerer(offresDe('enfants').map((o) => o.intitule))}. Tout se fait en touché contrôlé, et les âges exacts sont sur le planning du club.`,
  },
  {
    titre: 'Et en voiture ?',
    texte: `${VOITURE.charAt(0).toUpperCase() + VOITURE.slice(1)}. Une seule limite communale à franchir, et le club est au 61.`,
  },
  {
    titre: 'J’hésite entre deux cours.',
    texte: 'Commence par celui qui te fait le moins peur, et change en cours d’année : le club accueille les changements de discipline. Le moteur plus haut te dit lequel regarder en premier selon ton créneau.',
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LA LIMITE ─────────── */}
  <section class="section creuse limite" id="limite" aria-labelledby="t-limite">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">02</span><span>La commune voisine</span></p>
      <div class="limite__tete">
        <h2 id="t-limite">
          {SITE.ville} touche {DESTINATION.ville},<br />
          <span class="limite__accent">et le club est de l’autre côté.</span>
        </h2>
        <p class="lead faible limite__intro">
          Quand tu cherches un club de boxe proche de {SITE.ville}, c’est
          celui-là&nbsp;: <strong>{DESTINATION.nom}</strong>, un club de sport de
          combat complet, proche de {SITE.ville}, au {DESTINATION.adresse}. {NOTE_SECTEUR}
        </p>
      </div>

      <LaLimite />

      <div class="limite__actions">
        <a class="bouton bouton--signal" href={DESTINATION.site} rel="noopener">
          <span>Ouvrir le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href="#trajet">
          <span>Le bus, gare de Portet puis L5</span><span class="fleche" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 03 — LA PREMIÈRE FOIS ─────────── */}
  <section class="section premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" legende />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">03</span><span>La première fois</span></p>
        <h2 id="t-premiere">Le premier jour, tu frappes au sac et le coach règle l’intensité sur toi.</h2>
        <p class="lead faible">
          Le premier jour est le même pour tous les sports de combat à proximité
          de {SITE.ville}&nbsp;: boxe anglaise, kick-boxing ou MMA. Voilà comment
          il se passe.
        </p>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Pour les gants et les bandes, tu demandes au club en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Corde, puis un geste décomposé lentement.</strong> Tu le répètes au sac, et le coach le corrige aux pattes d’ours.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Tu frappes, et c’est tout.</strong> L’opposition vient bien plus tard, et seulement si tu la demandes.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <div class="premiere__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Ma première séance, sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé complet, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 04 — LES COURS ─────────── */}
  <section class="section encre cours" aria-labelledby="t-cours">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">04</span><span>{COMBIEN_COURS.charAt(0).toUpperCase() + COMBIEN_COURS.slice(1)} cours</span></p>
      <div class="cours__tete">
        <h2 id="t-cours">
          Tu veux frapper, contrôler au sol, ou les deux&nbsp;:<br />
          voilà quel cours viser.
        </h2>
        <p class="lead faible cours__intro">
          Si tu cherches un club de MMA près de {SITE.ville}, c’est la cage&nbsp;:
          {' '}{DESTINATION.singularite} Les {COMBIEN_COURS} cours publiés par le
          club, rangés par ce que tu as envie de faire, sous leur intitulé exact.
        </p>
      </div>

      <ol class="cours__liste">
        {VOIES.map((v, i) => (
          <li class="reveler" style={`--retard:${i * 60}ms`}>
            <a class="cours__page" href={route(v.page).chemin}>
              <span class="mono cours__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="cours__corps">
                <span class="cours__nom">{v.nom}</span>
                <span class="cours__intitules">
                  {v.offres.map((o, j) => (
                    <>
                      {j > 0 && <span aria-hidden="true"> · </span>}
                      <b>{o.intitule}</b>
                    </>
                  ))}
                </span>
                <span class="cours__detail">{v.quoi}</span>
              </span>
              <span class="fleche" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="cours__source mono">
        <a class="lien" href={DESTINATION.activites} rel="noopener">Le détail de chaque cours, sur le site du club ↗</a>
      </p>
    </div>
  </section>

  {/* ─────────── 05 — LE MOTEUR ─────────── */}
  <Seance titre={'Deux réponses, et tu sais\nquel cours regarder sur le planning.'} numero="05" />

  {/* ─────────── 06 — LE TRAJET ─────────── */}
  <section class="section creuse trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe trajet__inner">
      <div class="trajet__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>Y aller en bus</span></p>
        <h2 id="t-trajet">
          La {BUS.code} jusqu’à {BUS.a},<br />
          <span class="trajet__accent">le parvis, puis la {L5.code}.</span>
        </h2>
        <p class="lead faible">
          La {BUS.code} traverse {SITE.ville} et finit à {BUS.a}, {BUS.jours}. La
          {' '}{L5.code} part du même parvis, {L5.jours}&nbsp;: son premier arrêt est
          «&nbsp;{ARRIVEE.arret}&nbsp;», sur la {ARRIVEE.rue}. Le club est au 61.
        </p>
        <div class="trajet__actions">
          <a class="bouton bouton--signal" href={route('transports').chemin}>
            <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={DESTINATION.plannings} rel="noopener">
            <span>Le planning, pour caler ton bus</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <ol class="trajet__etapes">
        {MEILLEUR.etapes.map((e, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <span class={`trajet__code trajet__code--${e.mode}`}>{e.code}</span>
            <span class="trajet__corps">
              <span class="trajet__parcours"><b>{e.de}</b> → <b>{e.a}</b></span>
              <span class="mono trajet__jours">{e.jours}{e.precision ? ` · ${e.precision}` : ''}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ─────────── 07 — LES QUESTIONS ─────────── */}
  <section class="section questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Avant de venir</span></p>
        <h2 id="t-questions">Ce que les {SITE.gentile}<br />demandent avant de venir.</h2>
        <p class="lead faible">
          Chaque réponse commence par ce qui existe. Pour le reste, le club
          répond au <a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a>.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LE SECTEUR ─────────── */}
  <section class="section creuse secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">08</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Tu pars {DEPUIS_COMMUNES}&nbsp;?<br />
          <span class="secteur__accent">Ta commune a sa page.</span>
        </h2>
        <p class="lead faible secteur__intro">
          Boxing Center accueille les {SITE.gentile} dans son club de
          {' '}{DESTINATION.ville}, et les habitants du {SITE.secteur} par les
          mêmes axes. Chaque page dit la ligne à prendre, la route en voiture,
          et l’arrêt où descendre.
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c) => (
          <li class="reveler">
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[0].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">{DESTINATION.nomCourt}</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mono secteur__cle">Les {COMBIEN_LIMITROPHES} communes limitrophes de {SITE.ville}</p>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied faible">
        {VILLE.statut.valeur.charAt(0).toUpperCase() + VILLE.statut.valeur.slice(1)},
        {' '}{VILLE.population.valeur}. Accès par {VILLE.routes.valeur}&nbsp;;
        en transports, {VILLE.bus.valeur}.
      </p>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section convergence" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Il te reste à réserver chez le club,<br />
        <span class="convergence__accent">ou à nous écrire en deux lignes.</span>
      </h2>
      <p class="lead convergence__texte">
        La séance d’essai se réserve sur le site du club. Si tu préfères
        demander d’abord, décris ta semaine en deux lignes et on te répond avec
        le cours et le moment.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Écrire en deux lignes</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 La limite ──────────────────────────────────────────────────── */
  .limite__tete {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--e-5) var(--e-8);
    align-items: end;
  }
  @media (max-width: 62rem) { .limite__tete { grid-template-columns: 1fr; } }
  .limite h2 { max-width: 20ch; }
  .limite__accent { color: var(--signal-texte); }
  .limite__intro { max-width: 52ch; }
  .limite__intro strong { color: var(--encre); font-weight: 600; }
  .limite__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  /* ── 03 La première fois ───────────────────────────────────────────── */
  .premiere__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .premiere__inner { grid-template-columns: 1fr; gap: var(--e-7); } }
  .premiere h2 { max-width: 22ch; margin-bottom: var(--e-4); }
  .premiere .lead { max-width: 46ch; margin-bottom: var(--e-5); }
  .premiere__etapes { list-style: none; margin: 0 0 var(--e-6); padding: 0; display: grid; gap: var(--e-4); }
  .premiere__etapes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-3);
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
  }
  .premiere__etapes li:last-child { border-bottom: 0; }
  .premiere__etapes .mono { color: var(--signal-texte); font-weight: 700; }
  .premiere__etapes p { margin: 0; color: var(--texte-faible); }
  .premiere__etapes strong { color: var(--texte); font-weight: 600; }
  .premiere__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); }
  .premiere__lien { font-weight: 600; }

  /* ── 04 Les cours ──────────────────────────────────────────────────── */
  .cours__tete {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .cours__tete { grid-template-columns: 1fr; } }
  .cours h2 { max-width: 24ch; }
  .cours__intro { max-width: 50ch; }
  .cours__liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--trait); }
  .cours__liste > li { border-bottom: 1px solid var(--trait); }
  .cours__page {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-5) 0;
    color: inherit;
    text-decoration: none;
    transition: transform var(--d-rapide) var(--e-sortie);
  }
  .cours__page:hover { transform: translateX(6px); }
  .cours__page .fleche { color: var(--signal-texte); }
  .cours__num { color: var(--signal-texte); font-weight: 700; }
  .cours__corps { display: grid; gap: 0.3rem; min-width: 0; }
  .cours__nom { font-family: var(--police-titre); font-size: var(--t-h3); font-weight: 700; }
  .cours__intitules { font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__intitules b { color: var(--texte); font-weight: 600; }
  .cours__detail { font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__source { margin-top: var(--e-5); }
  @media (max-width: 44rem) { .cours__page { grid-template-columns: 2.4rem 1fr auto; } }

  /* ── 06 Le trajet ──────────────────────────────────────────────────── */
  .trajet__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .trajet__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .trajet h2 { max-width: 18ch; margin-bottom: var(--e-4); }
  .trajet__accent { color: var(--signal-texte); }
  .trajet .lead { max-width: 46ch; }
  .trajet__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }
  .trajet__etapes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-3); }
  .trajet__etapes li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--trait);
    background: var(--papier-vif);
  }
  .trajet__code {
    display: grid;
    place-items: center;
    padding: 0.45rem 0.5rem;
    border-radius: 0.35rem;
    background: var(--encre);
    color: var(--papier-vif);
    font-family: var(--police-mono);
    font-size: var(--t-petit);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .trajet__corps { display: grid; gap: 0.2rem; min-width: 0; }
  .trajet__parcours { font-size: var(--t-petit); }
